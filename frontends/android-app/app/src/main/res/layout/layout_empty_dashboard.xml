<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <!-- Illustration placeholder (replace with actual illustration later) -->
    <ImageView android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_image_placeholder"
        android:importantForAccessibility="no" />

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/empty_no_upcoming_meetings"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface" android:textSize="18sp"
        android:textStyle="bold" />

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/empty_schedule_meeting"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScheduleNew" android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/action_schedule" android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="@dimen/corner_radius_lg" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="?attr/colorSurfaceVariant">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header -->
        <RelativeLayout android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView android:id="@+id/imgAvatar"
                android:layout_width="@dimen/avatar_size_sm"
                android:layout_height="@dimen/avatar_size_sm"
                android:background="@drawable/bg_image_placeholder"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/cd_avatar" />

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/app_name"
                android:textSize="20sp" android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_centerInParent="true" />

            <FrameLayout android:id="@+id/btnSettingsWrapper"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView android:id="@+id/btnSettings"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:layout_gravity="center" android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/cd_settings" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Quick Actions -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="@dimen/spacing_lg">

            <!-- New Meeting -->
            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNewMeeting"
                    android:layout_width="@dimen/quick_action_size"
                    android:layout_height="@dimen/quick_action_size"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="@dimen/corner_radius_xl"
                    app:cardElevation="0dp" android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_new_meeting">

                    <ImageView android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:src="@drawable/ic_videocam"
                        app:tint="?attr/colorOnPrimary" android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_new_meeting"
                    android:textColor="?attr/colorOnSurface" android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_new_meeting_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Join Meeting -->
            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJoinMeeting"
                    android:layout_width="@dimen/quick_action_size"
                    android:layout_height="@dimen/quick_action_size"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/corner_radius_xl"
                    app:cardElevation="2dp" android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_join_meeting">

                    <ImageView android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:src="@drawable/ic_add" app:tint="?attr/colorPrimary"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_join_meeting"
                    android:textColor="?attr/colorOnSurface" android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_join_meeting_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Schedule -->
            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSchedule"
                    android:layout_width="@dimen/quick_action_size"
                    android:layout_height="@dimen/quick_action_size"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/corner_radius_xl"
                    app:cardElevation="2dp" android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_schedule_meeting">

                    <ImageView android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:src="@drawable/ic_calendar_outlined"
                        app:tint="?attr/colorPrimary" android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_schedule"
                    android:textColor="?attr/colorOnSurface" android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_schedule_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Upcoming Meetings Section -->
        <RelativeLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl">

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_upcoming_meetings"
                android:textColor="?attr/colorOnSurface" android:textSize="20sp"
                android:textStyle="bold" android:layout_alignParentStart="true"
                android:accessibilityHeading="true" />

            <TextView android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:gravity="center_vertical"
                android:text="@string/action_see_all"
                android:textColor="?attr/colorPrimary" android:textSize="14sp"
                android:textStyle="bold" android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Empty state (hidden by default) -->
        <include android:id="@+id/layoutEmptyState"
            layout="@layout/layout_empty_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone" />

        <!-- Meetings container (shown when there are meetings) -->
        <LinearLayout android:id="@+id/meetingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Meeting Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md"
                    android:gravity="center_vertical">

                    <ImageView android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:background="@drawable/bg_image_placeholder"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:padding="12dp" android:src="@drawable/ic_videocam"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />

                    <LinearLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_md">

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Design Sync"
                            android:textColor="?attr/colorOnSurface" android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:30 AM - 11:30 AM"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/action_join" android:textAllCaps="false"
                        app:cornerRadius="@dimen/corner_radius_lg"
                        app:backgroundTint="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Meeting Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md"
                    android:gravity="center_vertical">

                    <ImageView android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:background="@drawable/bg_image_placeholder"
                        android:backgroundTint="?attr/colorSurfaceVariant"
                        android:padding="12dp" android:src="@drawable/ic_home_outlined"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />

                    <LinearLayout android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_md">

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product Review"
                            android:textColor="?attr/colorOnSurface" android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1:00 PM - 2:00 PM"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/action_wait"
                        android:textColor="?attr/colorOnSurface"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/corner_radius_lg"
                        app:backgroundTint="?attr/colorSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>

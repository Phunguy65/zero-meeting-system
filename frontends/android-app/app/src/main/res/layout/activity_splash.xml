<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface" android:gravity="center"
    android:orientation="vertical">

    <!-- App name / logo -->
    <TextView android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/app_name"
        android:textColor="?attr/colorOnSurface" android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Session expired container (hidden by default) -->
    <LinearLayout android:id="@+id/sessionExpiredContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="32dp"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:accessibilityLiveRegion="polite" android:visibility="gone"
        tools:visibility="visible">

        <ImageView android:layout_width="48dp"
            android:layout_height="48dp" android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/session_expired_title"
            android:textColor="?attr/colorOnSurface" android:textSize="16sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/session_expired_message"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>

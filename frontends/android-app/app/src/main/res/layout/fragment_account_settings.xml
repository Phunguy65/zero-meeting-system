<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Loading indicator -->
        <ProgressBar android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_xl"
            android:visibility="gone" />

        <!-- Avatar section -->
        <FrameLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md">

            <ImageView android:id="@+id/imgAvatar"
                android:layout_width="@dimen/avatar_size_xl"
                android:layout_height="@dimen/avatar_size_xl"
                android:background="@drawable/bg_image_placeholder"
                android:scaleType="centerCrop" android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_avatar_tap_to_change" />

            <!-- Camera badge overlay -->
            <ImageView android:id="@+id/imgCameraBadge"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_avatar_edit_badge"
                android:src="@drawable/ic_camera" android:padding="6dp"
                app:tint="?attr/colorOnPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView android:id="@+id/tvChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/account_settings_change_photo"
            android:textColor="?attr/colorPrimary" android:textSize="14sp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/spacing_xs"
            android:contentDescription="@string/account_settings_change_photo" />

        <!-- Form fields -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:hint="@string/account_settings_full_name"
            app:errorEnabled="true"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" android:maxLength="255" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/account_settings_username"
            app:errorEnabled="true"
            app:helperText="@string/account_settings_username_helper"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:maxLength="30" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/account_settings_email"
            app:helperText="@string/account_settings_email_readonly"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="none"
                android:enabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Spacer to push button to bottom -->
        <View android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl" android:enabled="false"
            android:text="@string/account_settings_save"
            app:cornerRadius="@dimen/corner_radius_md" />

        <!-- Danger zone -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl" />

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/account_settings_danger_zone_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorError" />

        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/account_settings_danger_zone_description"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/account_settings_delete_account"
            android:textColor="?attr/colorError"
            app:cornerRadius="@dimen/corner_radius_md"
            app:iconTint="?attr/colorError" app:rippleColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>

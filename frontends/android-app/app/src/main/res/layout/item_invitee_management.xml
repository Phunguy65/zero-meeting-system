<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_sm">

    <LinearLayout android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/tvInviteeEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface" android:textSize="14sp" />

        <TextView android:id="@+id/tvInviteeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResendInvite"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/schedule_invitee_action_resend"
        android:textAllCaps="false" android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRevokeInvite"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/schedule_invitee_action_revoke"
        android:textAllCaps="false" android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:strokeColor="@android:color/transparent" />

</LinearLayout>

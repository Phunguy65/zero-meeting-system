<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEmptyMeetingHistory"
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:gravity="center"
    android:orientation="vertical" android:padding="@dimen/spacing_xl">

    <ImageView android:layout_width="@dimen/avatar_size_xl"
        android:layout_height="@dimen/avatar_size_xl"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="@null" android:padding="@dimen/spacing_lg"
        android:src="@drawable/ic_history"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:accessibilityHeading="true"
        android:text="@string/meeting_history_empty_title"
        android:textColor="?attr/colorOnSurface" android:textSize="18sp"
        android:textStyle="bold" />

    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm" android:gravity="center"
        android:text="@string/meeting_history_empty_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyStartMeeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/meeting_history_empty_cta"
        android:textAllCaps="false" app:cornerRadius="@dimen/corner_radius_xl" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="io.github.phunguy65.zms.presentation.main.schedule.ScheduleFragment">

    <!-- Header / Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:id="@+id/btnBackWrapper"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="@string/cd_back"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_title"
            android:textColor="?attr/colorOnSurface" android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Meeting Topic -->
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_meeting_topic"
                android:textColor="?attr/colorOnSurface" android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="?attr/colorOutline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMeetingTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date and Time Row -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <!-- Date -->
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_date"
                        android:textColor="?attr/colorOnSurface" android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                        app:boxStrokeColor="?attr/colorOutline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDate" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:clickable="true"
                            android:focusable="true" android:focusableInTouchMode="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Start Time -->
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_start_time"
                        android:textColor="?attr/colorOnSurface" android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                        app:boxStrokeColor="?attr/colorOutline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTime" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:clickable="true"
                            android:focusable="true" android:focusableInTouchMode="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Duration -->
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/schedule_duration"
                android:textColor="?attr/colorOnSurface" android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:boxStrokeColor="?attr/colorOutline">

                <AutoCompleteTextView
                    android:id="@+id/tvDuration" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Meeting Settings Section Header -->
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:accessibilityHeading="true"
                android:text="@string/schedule_meeting_settings"
                android:textColor="?attr/colorOnSurface" android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Waiting Room Toggle -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingVertical="@dimen/spacing_sm">

                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_waiting_room"
                        android:textColor="?attr/colorOnSurface" android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/schedule_waiting_room_desc"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWaitingRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_xs"
                android:background="?attr/colorOutlineVariant" />

            <!-- Host Video Toggle -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingVertical="@dimen/spacing_sm">

                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_host_video"
                        android:textColor="?attr/colorOnSurface" android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="@string/schedule_host_video_desc"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHostVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="false" />
            </LinearLayout>

            <Space android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xl" />

            <!-- Schedule Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScheduleMeeting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_lg"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/schedule_button" android:textAllCaps="false"
                android:textSize="16sp" android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/corner_radius_xl" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

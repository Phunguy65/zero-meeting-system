<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Speaker button -->
        <FrameLayout android:id="@+id/btnSpeakerContainer"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:id="@+id/btnSpeaker"
                android:layout_width="@dimen/icon_container_md"
                android:layout_height="@dimen/icon_container_md"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_speaker"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_volume_up" app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <!-- Meeting info (center) -->
        <LinearLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView android:id="@+id/tvMeetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Meeting"
                android:textColor="?attr/colorOnSurface" android:textSize="18sp"
                android:textStyle="bold" />

            <TextView android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="00:00"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Leave button -->
        <TextView android:id="@+id/btnLeave"
            android:layout_width="wrap_content"
            android:minHeight="@dimen/touch_target_min" android:gravity="center"
            android:background="@drawable/bg_leave_button"
            android:clickable="true" android:focusable="true"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/call_leave"
            android:textColor="?attr/colorError" android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Video grid (placeholder for LiveKit) -->
    <LinearLayout android:id="@+id/videoGrid"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_sm"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Row 1: 2 video cards -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="4dp" android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="0dp">

                <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorOutline"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/spacing_sm"
                        android:background="?attr/colorSurface"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xxs"
                        android:text="@string/create_meeting_you"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="4dp" android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="0dp" app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp">

                <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="@dimen/spacing_sm"
                        android:background="@drawable/bg_circle_white"
                        android:importantForAccessibility="no" android:padding="4dp"
                        android:src="@drawable/ic_mic" app:tint="?attr/colorPrimary" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/spacing_sm"
                        android:background="?attr/colorSurface"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xxs"
                        android:text="Participant 1"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2: 2 video cards -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="4dp" android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="0dp">

                <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurfaceVariant"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/spacing_sm"
                        android:background="?attr/colorSurface"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xxs"
                        android:text="Participant 2"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="4dp" android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="0dp">

                <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurface"
                        android:importantForAccessibility="no" />

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/spacing_sm"
                        android:text="Participant 3"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <Space android:layout_width="match_parent"
            android:layout_height="100dp" />
    </LinearLayout>

    <!-- Floating controls -->
    <LinearLayout android:id="@+id/floatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:gravity="center" android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Camera toggle -->
        <FrameLayout android:id="@+id/btnFloatVideoContainer"
            android:layout_width="56dp" android:layout_height="56dp"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView android:id="@+id/btnFloatVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_enable_camera"
                android:padding="@dimen/spacing_md"
                android:src="@drawable/ic_videocam" app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <!-- Mic toggle -->
        <FrameLayout android:id="@+id/btnFloatMicContainer"
            android:layout_width="64dp" android:layout_height="64dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView android:id="@+id/btnFloatMic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_blue"
                android:contentDescription="@string/cd_mute_mic"
                android:padding="@dimen/spacing_md" android:src="@drawable/ic_mic"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>

        <!-- Chat button -->
        <FrameLayout android:id="@+id/btnFloatChatContainer"
            android:layout_width="56dp" android:layout_height="56dp"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView android:id="@+id/btnFloatChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_open_chat"
                android:padding="@dimen/spacing_md" android:src="@drawable/ic_chat"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_lg"
        android:background="?attr/colorSurface" android:elevation="8dp"
        android:orientation="horizontal" android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Participants button -->
        <RelativeLayout android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1">

            <FrameLayout android:id="@+id/btnParticipantsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView android:id="@+id/btnNAVParticipant"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/call_participants"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/ic_person_filled"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <!-- Badge -->
            <TextView android:id="@+id/tvParticipantCount"
                android:layout_width="@dimen/spacing_md"
                android:layout_height="@dimen/spacing_md"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_badge_red" android:gravity="center"
                android:text="4" android:textColor="?attr/colorOnPrimary"
                android:textSize="10sp" android:textStyle="bold" />
        </RelativeLayout>

        <!-- More options button -->
        <FrameLayout android:id="@+id/btnMoreContainer"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView android:id="@+id/btnMore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_more_options"
                android:padding="@dimen/spacing_md"
                android:src="@drawable/ic_settings" app:tint="?attr/colorPrimary" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant"
    tools:context="io.github.phunguy65.zms.presentation.main.meeting.CreateMeetingFragment">

    <!-- Header / Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:id="@+id/btnBackWrapper"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="@string/cd_back"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meeting_title"
            android:textColor="?attr/colorOnSurface" android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPreview" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_margin="@dimen/spacing_lg"
        app:cardCornerRadius="@dimen/corner_radius_md" app:cardElevation="0dp"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera preview placeholder -->
            <ImageView android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <!-- "You" badge -->
            <LinearLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/bg_rounded_gray"
                android:backgroundTint="@color/overlay_scrim"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xxs"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView android:layout_width="@dimen/icon_size_xs"
                    android:layout_height="@dimen/icon_size_xs"
                    android:src="@drawable/ic_person_filled"
                    app:tint="?attr/colorOnPrimary"
                    android:importantForAccessibility="no" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    android:text="@string/create_meeting_you"
                    android:textColor="?attr/colorOnPrimary" android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Options Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOptions" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_lg"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/corner_radius_md" app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardPreview">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Video Toggle Row -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="@dimen/icon_container_md"
                    android:layout_height="@dimen/icon_container_md"
                    android:background="@drawable/bg_rounded_gray"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_videocam" app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/create_meeting_video"
                    android:textColor="?attr/colorOnSurface" android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVideo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_sm"
                android:background="?attr/colorOutlineVariant" />

            <!-- Audio Toggle Row -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="@dimen/icon_container_md"
                    android:layout_height="@dimen/icon_container_md"
                    android:background="@drawable/bg_rounded_gray"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:padding="@dimen/spacing_xs" android:src="@drawable/ic_mic"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />

                <TextView android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/create_meeting_audio"
                    android:textColor="?attr/colorOnSurface" android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAudio" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Copy Link Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyLink"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_lg"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="@string/create_meeting_copy_link"
        android:textAllCaps="false" android:textColor="?attr/colorPrimary"
        android:textSize="16sp" android:textStyle="bold"
        app:backgroundTint="?attr/colorSurface"
        app:cornerRadius="@dimen/corner_radius_sm"
        app:icon="@drawable/ic_content_copy" app:iconGravity="textStart"
        app:iconTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent" app:strokeWidth="0dp" />

    <!-- Start Meeting Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartMeeting" android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_lg"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/create_meeting_start"
        android:textAllCaps="false" android:textSize="16sp"
        android:textStyle="bold" app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="@dimen/corner_radius_sm"
        app:layout_constraintBottom_toTopOf="@id/btnCopyLink" />

</androidx.constraintlayout.widget.ConstraintLayout>

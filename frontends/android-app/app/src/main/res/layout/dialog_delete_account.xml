<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeleteConfirm" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/account_settings_delete_confirm_hint"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeleteConfirm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>

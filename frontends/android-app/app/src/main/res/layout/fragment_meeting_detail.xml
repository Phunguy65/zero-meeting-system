<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="io.github.phunguy65.zms.presentation.main.history.MeetingDetailFragment">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:id="@+id/btnBackWrapper"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meeting_detail_title"
            android:textColor="?attr/colorOnSurface" android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout android:id="@+id/contentFrame"
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- Loading state -->
        <ProgressBar android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" />

        <!-- Error state -->
        <LinearLayout android:id="@+id/layoutErrorState"
            android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:orientation="vertical" android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <TextView android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textColor="?attr/colorError" android:textSize="14sp"
                tools:text="@string/meeting_history_error_subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/retry" android:textAllCaps="false"
                app:cornerRadius="@dimen/corner_radius_xl" />
        </LinearLayout>

        <!-- Success content -->
        <ScrollView android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false"
            android:fillViewport="true" android:paddingBottom="@dimen/spacing_xl"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <!-- Title + badges -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_lg">

                    <TextView android:id="@+id/tvTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp" android:textStyle="bold"
                        tools:text="Design Review Sync" />

                    <TextView android:id="@+id/tvTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_history_badge_neutral"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xxs"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" android:textStyle="bold"
                        tools:text="SCHEDULED" />

                    <TextView android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:background="@drawable/bg_history_badge_neutral"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xxs"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" android:textStyle="bold"
                        tools:text="ENDED" />
                </LinearLayout>

                <!-- Date / time / duration -->
                <TextView android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                    tools:text="Wednesday, April 16, 2026" />

                <TextView android:id="@+id/tvTimeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" tools:text="2:30 PM - 3:15 PM · 45 min" />

                <!-- Description section -->
                <LinearLayout android:id="@+id/sectionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:visibility="gone" tools:visibility="visible">

                    <TextView android:accessibilityHeading="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meeting_detail_section_description"
                        android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        tools:text="Review Q2 design system proposals and sign off on the roadmap." />
                </LinearLayout>

                <!-- Participants section -->
                <LinearLayout android:id="@+id/sectionParticipants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tvParticipantsHeader"
                        android:accessibilityHeading="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                        android:textStyle="bold" tools:text="Participants (4)" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerParticipants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:nestedScrollingEnabled="false" tools:itemCount="3"
                        tools:listitem="@layout/item_participant_detail" />

                    <TextView android:id="@+id/btnExpandParticipants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:textColor="?attr/colorPrimary" android:textSize="14sp"
                        android:textStyle="bold" android:visibility="gone"
                        tools:text="+ 3 more" tools:visibility="visible" />
                </LinearLayout>

                <!-- Recordings section -->
                <LinearLayout android:id="@+id/sectionRecordings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical" android:visibility="gone"
                    tools:visibility="visible">

                    <TextView android:id="@+id/tvRecordingsHeader"
                        android:accessibilityHeading="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                        android:textStyle="bold" tools:text="Recordings (1)" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecordings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:nestedScrollingEnabled="false" tools:itemCount="1"
                        tools:listitem="@layout/item_recording" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Playback overlay -->
        <FrameLayout android:id="@+id/playerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black" android:visibility="gone"
            tools:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView" android:layout_width="match_parent"
                android:layout_height="match_parent" app:resize_mode="fit"
                app:show_buffering="when_playing" app:use_controller="true" />

            <FrameLayout android:id="@+id/btnClosePlayerWrapper"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true">

                <ImageView android:id="@+id/btnClosePlayer"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close" app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout android:id="@+id/layoutPlayerError"
                android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:orientation="vertical" android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:text="@string/meeting_detail_playback_error"
                    android:textColor="@android:color/white" android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayerRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/retry" android:textAllCaps="false"
                    app:cornerRadius="@dimen/corner_radius_xl" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg">

    <ImageView android:id="@+id/ivLangIcon"
        android:layout_width="24dp" android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_language"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView android:id="@+id/tvLangLabel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Tiếng Việt (Vietnamese)" />

    <ImageView android:id="@+id/ivCheck"
        android:layout_width="24dp" android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check" android:visibility="gone"
        app:tint="?attr/colorPrimary" tools:visibility="visible" />

</LinearLayout>
